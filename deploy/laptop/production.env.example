# Скопируйте этот файл в папку backend под именем .production.env
# и подставьте пароль базы и свой PRIVATE_KEY.
# Проверка выключена только при LICENSE_REQUIRED=false.
# Если строки нет или значение другое — лицензия обязательна.

LICENSE_REQUIRED=true

HOST=127.0.0.1
PORT=7008
CORS_ORIGINS=http://127.0.0.1:3008,http://localhost:3008

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SherzodAka
POSTGRES_DB=kord

PRIVATE_KEY=change-me-long-random-secret

SWAGGER_ENABLED=false
TELEGRAM_POLLING=false
TELEGRAM_FURNITURE_CLIENT_ENABLED=false
TELEGRAM_FURNITURE_SALARY_ENABLED=false
TELEGRAM_FURNITURE_WORKER_ENABLED=false
TELEGRAM_RENTAL_MEDIATOR_ENABLED=false
TELEGRAM_RENTAL_CLIENT_ENABLED=false
TELEGRAM_DASHBOARD_AUTH_ENABLED=false
TELEGRAM_DASHBOARD_OTP_ENABLED=false
